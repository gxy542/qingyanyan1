# ============================================================================
# .env.example — 环境变量模板（只列变量名与说明，不含真实密钥）
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不会进入 git。
# 启动：cp .env.example .env
# ============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres        # initdb 超级用户（仅用于建库/建表/授权）
POSTGRES_PASSWORD=postgres_change_me   # 超级用户口令（本地实验可改）
POSTGRES_DB=gradebook         # 数据库名（schema/roles 中的库名需与此一致）

# ---------- 应用数据库角色（app_api，最小权限，见 db/roles.sql）----------
APP_DB_USER=app_api           # 应用连接数据库使用的角色
APP_DB_PASSWORD=app_secret_change_me  # 该角色口令，必须与 db/roles.sql 一致

# ---------- 连接串（容器内主机名：db / redis）----------
DATABASE_URL=postgresql://app_api:app_secret_change_me@db:5432/gradebook
REDIS_URL=redis://redis:6379/0

# ---------- 令牌（任务 3.2）----------
# JWT 签名密钥：必须设置，用于签发/验签访问令牌，切勿提交到仓库
JWT_SECRET=change_me_32_chars_random_string
JWT_ALGORITHM=HS256          # JWT 签名算法
ACCESS_TOKEN_TTL_MINUTES=30  # 访问令牌有效期（分钟）

# ---------- 密码哈希（任务 3.1）----------
# pepper：服务端额外密钥，先与密码拼接再哈希；只存环境变量，绝不进数据库
PASSWORD_PEPPER=change_me_pepper_string
# Argon2id 成本参数（OWASP 推荐值）
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536     # 内存成本（KiB = 64 MiB）
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32

# ---------- 本地邮件桩 Mailpit（任务 3.3）----------
MAIL_HOST=mailpit            # 容器内主机名；本地直接跑 Python 时用 localhost
MAIL_PORT=1025               # Mailpit SMTP 端口
MAIL_FROM=gradebook@example.edu   # 发件人地址

# ---------- 找回密码（任务 3.3）----------
RESET_CODE_TTL_MINUTES=15    # 一次性验证码有效期（分钟）

# ---------- 限流（任务 3.2 / TB-01）----------
LOGIN_RATE_LIMIT=5           # 登录/注册窗口内最大尝试次数
RATE_LIMIT_WINDOW_SECONDS=60 # 限流窗口（秒）

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000   # 允许的前端来源（逗号分隔）
